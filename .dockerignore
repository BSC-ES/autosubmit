# Version control
.git
.git/**
.github

# Python packaging and build artefacts
*.egg-info
*.tar.gz
*.whl
build
dist

# Documentation and auxiliary resources
docs
easybuild
man
scripts

# Tests and test-related resources
**/.pytest_cache
.benchmarks
.coverage
.coverage.*
coverage.xml
htmlcov
test

# Python bytecode and interpreter caches
**/__pycache__
*$py.class
*.py[cod]

# Linters, formatters and static analysis caches
**/.dmypy.json
**/.mypy_cache
**/.pyre
**/.pytype
**/.ruff_cache

# Virtual environments and Python environment managers
**/.env
**/.nox
**/.tox
**/.venv
**/ENV
**/env
**/venv

# IDE and editor configuration
**/.idea
**/.vscode
*~
*.swo
*.swp

# OS-generated files
.DS_Store
Desktop.ini
Thumbs.db

# Temporary and log files
*.log
*.temp
*.tmp

# Docker development runtime data
docker/postgres/database/*
!docker/postgres/database/.gitkeep
docker/postgres/experiments/*
!docker/postgres/experiments/.gitkeep
docker/postgres/logs/*
!docker/postgres/logs/.gitkeep
docker/postgres/metadata/*
!docker/postgres/metadata/.gitkeep
